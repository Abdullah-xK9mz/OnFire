rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role(r) { return signedIn() && request.auth.token.role == r; }
    function admin() { return role('admin'); }
    function teacher() { return role('teacher') || admin(); }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid) && request.resource.data.role == 'student';
      allow update: if admin() || (self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoURL','updatedAt']));
      allow delete: if admin();
    }
    match /grades/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /subjects/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /units/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /lessons/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /videos/{id} { allow read: if admin(); allow write: if admin(); }
    match /plans/{id} { allow read: if signedIn(); allow write: if admin(); }

    // Questions and correct answers are server-controlled.
    match /exams/{id} {
      // Students can read only the sanitized exam document; correct answers live separately.
      allow read: if signedIn() && resource.data.status == 'PUBLISHED' && (resource.data.gradeId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gradeId || admin());
      allow write: if admin();
    }
    match /examAnswerKeys/{id} {
      allow read, write: if teacher();
    }
    match /examAttempts/{id} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      allow create, update: if false; // all attempt mutations go through Cloud Functions
      allow delete: if admin();
    }
    match /examResults/{id} { allow read: if signedIn() && resource.data.studentId == request.auth.uid; allow write: if false; }
    match /progress/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin()); allow write: if false; }
    match /retakeRequests/{id} { allow read: if signedIn() && resource.data.studentId == request.auth.uid; allow write: if false; }

    match /subscriptions/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin()); allow write: if false; }
    match /payments/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin()); allow write: if false; }
    match /paymentReviews/{id} { allow read: if admin(); allow write: if false; }
    match /coupons/{id} { allow read: if admin(); allow write: if admin(); }
    match /certificates/{id} { allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin() || teacher()); allow write: if false; }
    match /notifications/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); allow create, delete: if false; }
    match /settings/{id} { allow read: if signedIn() && id == 'public'; allow write: if admin(); }
    match /teacherSubjects/{id} { allow read: if teacher(); allow write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
